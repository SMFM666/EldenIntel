<Window x:Class="EnemyIntel.App.GameCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Cam" Width="370" Height="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}" ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource Eyebrow}" Text="NATIVE CAMERA CONTROLS"/>
      <TextBlock Margin="0,5,0,0" FontSize="25" FontWeight="SemiBold" Text="GAME CAM"/>
      <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Bundled FreecamMod integration"/>
    </StackPanel>
    <Button x:Name="FreecamButton" Grid.Row="2" Height="50" Click="FreecamButton_Click" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Cursor="Hand" Content="ENABLE FREECAM"/>
    <Button x:Name="PauseButton" Grid.Row="4" Height="40" Click="PauseButton_Click" Content="REAL PAUSE"/>
    <Button x:Name="HudButton" Grid.Row="6" Height="40" Click="HudButton_Click" Content="HIDE HUD"/>
    <Button x:Name="InputButton" Grid.Row="8" Height="40" Click="InputButton_Click" Content="BLOCK PLAYER INPUT"/>
    <Button x:Name="LodButton" Grid.Row="10" Height="40" Click="LodButton_Click" Content="HIGHER LOD"/>
    <Button x:Name="ResetButton" Grid.Row="12" Height="40" Click="ResetButton_Click" Content="RESET CAMERA"/>
    <Button x:Name="StepButton" Grid.Row="14" Height="40" Click="StepButton_Click" Content="STEP FRAME"/>
    <StackPanel Grid.Row="16">
      <Grid><TextBlock Style="{StaticResource Eyebrow}" Text="MOVEMENT SPEED"/><TextBlock x:Name="SpeedValueText" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" Text="10.0"/></Grid>
      <Slider x:Name="SpeedSlider" Margin="0,8,0,0" Minimum="0.5" Maximum="50" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="SpeedSlider_ValueChanged" PreviewMouseLeftButtonUp="SpeedSlider_Commit"/>
      <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="0.5 precision  •  10 default  •  50 fast"/>
    </StackPanel>
    <Border Grid.Row="20" Style="{StaticResource Card}" Padding="13">
      <StackPanel>
        <TextBlock Style="{StaticResource Eyebrow}" Text="STATUS"/>
        <TextBlock x:Name="StatusText" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Ready. Elden Ring must be running without EAC."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
