<Window x:Class="EnemyIntel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EnemyIntel.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EldenIntel" Width="960" Height="960" MinWidth="820" MinHeight="760"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen" WindowStyle="None" ToolTipOpening="MainWindow_ToolTipOpening">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <FontFamily x:Key="DisplayFont">./assets/Fonts/Milker.otf#Milker</FontFamily>
    <FontFamily x:Key="PanelFont">./assets/Fonts/ZTNature-Bold.otf#ZT Nature</FontFamily>
    <!-- Light controls must own their text colors. The application-wide
         TextBlock style is white for the dark shell and must never bleed into
         a light ComboBox popup or its selected-value presenter. -->
    <DataTemplate x:Key="LightComboTextTemplate">
      <TextBlock Foreground="#08090A" FontWeight="SemiBold" Text="{Binding}"/>
    </DataTemplate>
    <Style x:Key="LightComboItemStyle" TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="Background" Value="#F2F2F2"/>
      <Setter Property="Foreground" Value="#08090A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#C9CDD2"/>
          <Setter Property="Foreground" Value="#08090A"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DCE1E6"/>
          <Setter Property="Foreground" Value="#08090A"/>
          <Setter Property="FontWeight" Value="Bold"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#565A60"/>
          <Setter Property="Opacity" Value="1"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LightComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Background" Value="#F2F2F2"/>
      <Setter Property="Foreground" Value="#08090A"/>
      <Setter Property="BorderBrush" Value="#8A8A8A"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="ItemTemplate" Value="{StaticResource LightComboTextTemplate}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource LightComboItemStyle}"/>
    </Style>
    <Style TargetType="Border">
      <EventSetter Event="Loaded" Handler="Border_Loaded"/>
    </Style>
    <Style TargetType="ToolTip">
      <EventSetter Event="Opened" Handler="HoverToolTip_Opened"/>
    </Style>
    <Style x:Key="CommandDeckTab" TargetType="Button">
      <Setter Property="Height" Value="36"/><Setter Property="Margin" Value="1,0,0,0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#FFF4F4F5"/><Setter Property="Foreground" Value="#FF08090A"/><Setter Property="BorderBrush" Value="White"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
          <Grid ClipToBounds="True"><Border Height="14" VerticalAlignment="Top" CornerRadius="8,8,3,3" Opacity="0.45"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CCFFFFFF"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Effect"><Setter.Value><DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CircularCaptureButton" TargetType="Button">
      <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#FFF4F4F5"/><Setter Property="Foreground" Value="#FF08090A"/><Setter Property="BorderBrush" Value="White"/><Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse x:Name="Chrome" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/><Ellipse Margin="3" Stroke="#22000000" StrokeThickness="1"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Effect"><Setter.Value><DropShadowEffect Color="White" BlurRadius="12" ShadowDepth="0" Opacity="0.48"/></Setter.Value></Setter></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#0A0B0D" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#8F939A" FontSize="9" FontWeight="SemiBold" Text="ELDENINTEL"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="38" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#8F939A" Click="MinimizeButton_Click" Content="—"/>
          <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="38" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#8F939A" Click="MaximizeButton_Click" Content="□"/>
          <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="38" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#8F939A" Click="CloseButton_Click" Content="×"/>
        </StackPanel>
      </Grid>
    </Border>
  <Grid Grid.Row="1" Margin="14,10,14,14">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button x:Name="CaptureButton" Style="{StaticResource CircularCaptureButton}" Click="CaptureButton_Click" Margin="0,0,8,0" ToolTip="Capture portrait  •  Ctrl+1" ContentTemplate="{x:Null}">
          <Grid Width="27" Height="27">
            <Ellipse Stroke="#090A0B" StrokeThickness="2"/>
            <Ellipse Width="11" Height="11" Stroke="#090A0B" StrokeThickness="2"/>
            <Path Stroke="#090A0B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 13.5,1 L 13.5,7 M 24.3,7 L 19.2,10 M 24.3,20 L 19.2,17 M 13.5,26 L 13.5,20 M 2.7,20 L 7.8,17 M 2.7,7 L 7.8,10"/>
          </Grid>
        </Button>
        <Border x:Name="AntiCheatPill" Height="42" Margin="0,0,8,0" Background="#1C1E22" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Padding="8,0" ToolTip="Memory-changing tools require a verified EAC-disabled session.">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="AntiCheatIndicator" Width="7" Height="7" Margin="0,0,7,0" Fill="#8F939A"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Foreground="#8F939A" FontSize="8" FontWeight="Bold" Text="SESSION SAFETY"/>
              <TextBlock x:Name="AntiCheatStatusText" Foreground="White" FontSize="10" FontWeight="Bold" Text="EAC UNVERIFIED"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Height="42" Background="#111316" BorderBrush="White" BorderThickness="1.5" CornerRadius="7" Padding="9,0" ToolTip="Live Elden Ring reader connection">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse"><Setter Property="Fill" Value="#FFFFFFFF"/><Setter Property="Effect" Value="{x:Null}"/><Style.Triggers><DataTrigger Binding="{Binding ConnectionLabel}" Value="LINKED"><Setter Property="Fill" Value="#FFFF3547"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFFF2338" BlurRadius="13" ShadowDepth="0" Opacity="0.95"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock FontSize="11" FontWeight="Black">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#777C84"/><Setter Property="Text" Value="OFF AIR"/><Style.Triggers><DataTrigger Binding="{Binding ConnectionLabel}" Value="LINKED"><Setter Property="Foreground" Value="White"/><Setter Property="Text" Value="LIVE"/></DataTrigger><DataTrigger Binding="{Binding ConnectionLabel}" Value="LINKING"><Setter Property="Text" Value="LINKING"/></DataTrigger><DataTrigger Binding="{Binding ConnectionLabel}" Value="FAULT"><Setter Property="Text" Value="FAULT"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
      <Grid Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
        <Button x:Name="CameraDrawerTab" Grid.Column="0" Style="{StaticResource CommandDeckTab}" Click="CameraDrawerTab_Click" ToolTip="Camera"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="CAMERA"/></Button>
        <Button x:Name="CamTrackDrawerTab" Grid.Column="1" Style="{StaticResource CommandDeckTab}" Click="CamTrackDrawerTab_Click" ToolTip="Camera Track"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="CAM TRACK"/></Button>
        <Button x:Name="OptionsDrawerTab" Grid.Column="2" Style="{StaticResource CommandDeckTab}" Click="OptionsDrawerTab_Click" ToolTip="Tools"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="TOOLS"/></Button>
        <Button x:Name="SpawnerDrawerTab" Grid.Column="3" Style="{StaticResource CommandDeckTab}" Click="SpawnerDrawerTab_Click" ToolTip="Enemy Spawner"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="SPAWNER"/></Button>
        <Button x:Name="ControlDrawerTab" Grid.Column="4" Style="{StaticResource CommandDeckTab}" Click="ControlDrawerTab_Click" ToolTip="Character Control"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="CONTROL"/></Button>
        <Button x:Name="PlaybackDrawerTab" Grid.Column="5" Style="{StaticResource CommandDeckTab}" Click="PlaybackDrawerTab_Click" ToolTip="Time Control"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="TIME"/></Button>
        <Button x:Name="StreamDrawerTab" Grid.Column="6" Style="{StaticResource CommandDeckTab}" Click="StreamDrawerTab_Click" ToolTip="Twitch Stream Lab"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="STREAM"/></Button>
        <Button x:Name="HotkeysDrawerTab" Grid.Column="7" Style="{StaticResource CommandDeckTab}" Click="HotkeysDrawerTab_Click" ToolTip="Hotkeys"><local:TrackingText FontFamily="{StaticResource PanelFont}" FontSize="15" CharacterSpacing="0.12" Foreground="#08090A" Text="HOTKEYS"/></Button>
      </Grid>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <Grid>
          <Image Source="{Binding PortraitImage}"
                 Stretch="UniformToFill"
                 StretchDirection="Both"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,0,0,46"
                 Opacity="0.86"/>
          <Rectangle Height="270" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#00000000" Offset="0"/>
                <GradientStop Color="#B8070809" Offset="0.32"/>
                <GradientStop Color="#F3070809" Offset="0.62"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <StackPanel VerticalAlignment="Bottom" Margin="20">
            <StackPanel Visibility="{Binding VitalsVisibility}" Margin="0,0,0,12">
              <TextBlock Style="{StaticResource Eyebrow}" Text="VITALITY"/>
              <Grid Height="28" Margin="0,5,0,10"><Border Background="#321B1D20" CornerRadius="4"/><ProgressBar Maximum="1" Value="{Binding HealthRatio, Mode=OneWay}" Foreground="#E8E8E9" Background="Transparent" BorderThickness="0"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#111214" FontSize="11" FontWeight="Bold" Text="{Binding HealthText}"/></Grid>
              <TextBlock Style="{StaticResource Eyebrow}" Text="STANCE"/>
              <Grid Height="22" Margin="0,5,0,0"><Border Background="#321B1D20" CornerRadius="4"/><ProgressBar Maximum="1" Value="{Binding PoiseRatio, Mode=OneWay}" Foreground="#74777D" Background="Transparent" BorderThickness="0"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding PoiseText}"/></Grid>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" MaxHeight="96">
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="60" Text="{Binding EnemyName}"/>
              </Viewbox>
              <Border Grid.Column="1" Visibility="{Binding DeadVisibility}" VerticalAlignment="Center" Margin="12,0,0,0" Padding="9,4" Background="#18FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="99">
                <TextBlock Foreground="#E8E8E9" FontSize="10" FontWeight="Bold" Text="DEAD"/>
              </Border>
            </Grid>
          </StackPanel>
          <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyVisibility}">
            <Image x:Name="EmptyStateMark" Width="270" Height="270" HorizontalAlignment="Center" Source="assets/Branding/EldenIntelEmblem.png" Stretch="Uniform" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Stretch" TextAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="White" Text="AWAITING TARGET"/>
            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="Lock onto an enemy in Elden Ring"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" FontFamily="{StaticResource DisplayFont}" FontSize="16" Text="EQUIPMENT" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding Equipment}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Tag="ItemHover" Background="{StaticResource RaisedBrush}" CornerRadius="9" Padding="8" Margin="0,0,0,6" MouseEnter="ItemHover_MouseEnter" MouseLeave="ItemHover_MouseLeave"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="38" Height="38" Background="#20FFFFFF" CornerRadius="6"><Image Source="{Binding ImagePath}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="15" Text="{Binding Slot}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" FontFamily="{StaticResource DisplayFont}" FontSize="16" Text="POSSIBLE DROPS  •  BASE CHANCE" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding Drops}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Tag="ItemHover" Background="Transparent" Margin="0,0,0,8" MouseEnter="ItemHover_MouseEnter" MouseLeave="ItemHover_MouseLeave"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#20FFFFFF" CornerRadius="6"><Image Source="{Binding ImagePath}"/></Border><StackPanel Grid.Column="1" Margin="8,0"><TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="15" Text="{Binding Category}"/></StackPanel><TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Text="{Binding ChancePercent, StringFormat={}{0:0.###}%}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

  </Grid>
    <Grid x:Name="OptionsDrawer" Grid.Row="1" Width="240" Height="760" Margin="0,52,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="20" RenderTransformOrigin="0.5,0">
      <Grid.RenderTransform><ScaleTransform x:Name="OptionsDrawerTransform" ScaleY="0"/></Grid.RenderTransform>
      <Border Background="#FA0D0F11" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="OPTIONS"/>
          <TextBlock Margin="0,3,0,12" FontSize="22" FontWeight="Bold" Text="TOOLS"/>
          <Button x:Name="DrawerDropRateButton" Height="42" Click="DrawerDropRateButton_Click" Content="DROP RATE ×10"/>
          <Button x:Name="DrawerAiButton" Height="42" Margin="0,8,0,0" Click="DrawerAiButton_Click" Content="DISABLE AI"/>
          <Button x:Name="DrawerNoDamageButton" Height="42" Margin="0,8,0,0" Click="DrawerNoDamageButton_Click" ToolTip="Prevent player HP loss while preserving hit reactions and blood effects" Content="NO PLAYER DAMAGE"/>
          <Button x:Name="DrawerSteadyPlayerButton" Height="42" Margin="0,8,0,0" Click="DrawerSteadyPlayerButton_Click" ToolTip="Give only the local player extreme poise to suppress ordinary stagger and knockback while retaining hit and blood effects" Content="STEADY PLAYER"/>
          <Button x:Name="DrawerWeaponHitboxButton" Height="42" Margin="0,8,0,0" Click="DrawerWeaponHitboxButton_Click" Content="WEAPON HITBOXES"/>
          <Button x:Name="DrawerHideWorldButton" Height="42" Margin="0,8,0,0" Click="DrawerHideWorldButton_Click" ToolTip="Hide terrain and world objects while leaving characters visible" Content="HIDE WORLD"/>
          <Button x:Name="HidePlayerButton" Height="42" Margin="0,8,0,0" Click="HidePlayerButton_Click" ToolTip="Hide the local player model from viewers for 20 seconds without changing enemy awareness" Content="HIDE PLAYER · 20s"/>
          <Button x:Name="NinjaSetButton" Height="42" Margin="0,8,0,0" Click="NinjaSetButton_Click" ToolTip="Apply the player-only Transmogrify Ninja Set appearance" Content="NINJA SET"/>
          <Button x:Name="ConfessorSetButton" Height="42" Margin="0,8,0,0" Click="ConfessorSetButton_Click" ToolTip="Apply the player-only Transmogrify Confessor Set appearance" Content="CONFESSOR SET"/>
          <Border Margin="0,12,0,0" BorderBrush="#45FFFFFF" BorderThickness="1,1,1,0"/>
          <TextBlock Margin="0,10,0,5" Style="{StaticResource Eyebrow}" Text="DISPLAY  •  32:9"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <CheckBox x:Name="UiFixEnabledCheckBox" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left"
                      Checked="UiFixEnabledCheckBox_Changed" Unchecked="UiFixEnabledCheckBox_Changed"
                      ToolTip="Enable or disable the selected 32:9 interface fix"/>
            <ComboBox x:Name="UiFixPicker" Grid.Column="1" Style="{StaticResource LightComboBoxStyle}" Height="38" Padding="8,0"
                      DisplayMemberPath="Display" SelectionChanged="UiFixPicker_SelectionChanged"/>
          </Grid>
          <TextBlock x:Name="UiFixStatusText" Margin="34,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"
                     Text="Select a fix. Changes apply on the next Elden Ring launch."/>
          <Border Margin="0,12,0,0" BorderBrush="#45FFFFFF" BorderThickness="1,1,1,0"/>
          <TextBlock Margin="0,10,0,5" Style="{StaticResource Eyebrow}" Text="ANIMATION LAB  •  EXPERIMENTAL"/>
          <ComboBox x:Name="GesturePicker" Style="{StaticResource LightComboBoxStyle}" Height="38" Padding="8,0"
                    DisplayMemberPath="Display"/>
          <Button x:Name="PlayGestureButton" Height="38" Margin="0,7,0,0" Click="PlayGestureButton_Click" ToolTip="Trigger the selected in-game gesture. Custom replacements work when their animation mod is installed." Content="PLAY GESTURE"/>
          <TextBlock x:Name="DrawerStatusText" Margin="0,9,0,15" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Text="Open the drawer while Elden Ring is running."/>
          <TextBlock Style="{StaticResource Eyebrow}" Text="SHORTCUTS"/>
          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource MutedBrush}" Text="HUD"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="F2"/></Grid>
          <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource MutedBrush}" Text="Capture"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+1"/></Grid>
          <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource MutedBrush}" Text="Pause"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+P"/></Grid>
          <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource MutedBrush}" Text="Freecam"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+F6"/></Grid>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="SpawnerDrawer" Grid.Row="1" Width="240" Height="520" Margin="0,52,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="22" RenderTransformOrigin="0.5,0">
      <Grid.RenderTransform><ScaleTransform x:Name="SpawnerDrawerTransform" ScaleY="0"/></Grid.RenderTransform>
      <Border Background="#FA0D0F11" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource Eyebrow}" Text="WORLD"/>
          <TextBlock Margin="0,3,0,11" FontSize="22" FontWeight="Bold" Text="ENEMY SPAWNER"/>
          <TextBox x:Name="BossSearchBox" Height="38" Padding="10,7" Background="#F2F2F2" Foreground="#08090A" BorderBrush="#8A8A8A" FontWeight="Bold" TextChanged="BossSearchBox_TextChanged" ToolTip="Search all validated base-game and Shadow of the Erdtree boss encounters"/>
          <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="Type a boss name to search 211 encounters."/>
          <ListBox x:Name="BossSearchResults" MaxHeight="150" Margin="0,7,0,0" Visibility="Collapsed" Background="#FF111317" BorderBrush="#55FFFFFF" Foreground="White" SelectionChanged="BossSearchResults_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Padding="7,5" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Margin="0,8,0,0" Padding="9" Background="#16FFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="SelectedBossText" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" Text="NO BOSS SELECTED"/>
          </Border>
          <TextBlock Margin="0,12,0,5" Style="{StaticResource Eyebrow}" Text="SCALING"/>
          <ComboBox x:Name="EnemySpawnScalingBox" Style="{StaticResource LightComboBoxStyle}" Height="38" Padding="9,0" FontWeight="Bold"/>
          <Button x:Name="EnemySpawnMultipleButton" Height="36" Margin="0,12,0,0" Click="EnemySpawnMultipleButton_Click" Content="SPAWN MULTIPLE · OFF"/>
          <StackPanel x:Name="EnemySpawnMultiplePanel" Visibility="Collapsed">
