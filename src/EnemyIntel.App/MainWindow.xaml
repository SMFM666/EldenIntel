          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Capture portrait"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+1"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pause"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+P"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Freecam"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+F6"/></Grid>
          <Border Margin="0,15,0,13" Height="1" Background="#28FFFFFF"/>
          <TextBlock Style="{StaticResource Eyebrow}" Text="FREECAM · SUBJECT"/>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pick / release focus"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+A"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Lock mouse camera"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="MMB"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Orbit"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Mouse"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Distance"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Wheel"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Aim height"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+Wheel"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Pan left/right"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Ctrl+Shift+Wheel"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="FOV"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Alt+Wheel"/></Grid>
          <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Raise / lower"/><TextBlock Grid.Column="1" FontFamily="Consolas" Text="Space / Shift"/></Grid>
          <TextBlock Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Text="Camera effects remain armed while changing pages. Context-dependent effects begin automatically when a valid focus is available."/>
        </StackPanel>
      </Border>
    </Grid>
    <!-- MANDATORY: Item hover cards must remain opaque, stable, and inside this
         main-window layer so OBS Window Capture always receives them. Never
         replace this with ToolTip, Popup, another Window, or a redraw timer. -->
    <Canvas x:Name="InWindowHoverLayer" Grid.Row="1" Panel.ZIndex="100" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="InWindowHoverCard" Width="440" Opacity="0" Background="#FF08090B" BorderBrush="White" BorderThickness="1.5" CornerRadius="14" Padding="20" SnapsToDevicePixels="True">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#FF08090B" CornerRadius="10">
            <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="10"/>
          </Border>
          <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Foreground="#D0D2D6" FontSize="16" FontWeight="SemiBold" Text="{Binding Category}"/>
            <TextBlock Margin="0,4,0,0" Foreground="White" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Name}"/>
            <TextBlock Margin="0,9,0,0" Foreground="#D5D7DD" FontSize="18" LineHeight="25" TextWrapping="Wrap" Text="{Binding Description}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Canvas>
  </Grid>
</Window>
